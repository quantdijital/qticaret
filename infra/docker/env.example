# Template for infra/docker/.env, created by scripts/init-dev-env.sh, which
# fills every __GENERATED__ value. Never commit the real file (docs/04).
# Users, ports and the bucket name are fixed in compose.dev.yml and
# apps/backend/env.example; only secrets live here.
POSTGRES_PASSWORD=__GENERATED__
S3_ACCESS_KEY_ID=__GENERATED__
S3_SECRET_ACCESS_KEY=__GENERATED__
# F18 (adr/0046 §5): the storefront's server signs the shopper's address with
# it; the backend checks the signature. Shared by both sides' env files
STOREFRONT_IP_SECRET=__GENERATED__
