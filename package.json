{
  "name": "qticaret",
  "private": true,
  "description": "Quant Ticaret — multi-tenant e-commerce infrastructure by Quant Dijital",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@qticaret/config/prettier",
  "devDependencies": {
    "@qticaret/config": "workspace:*",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
