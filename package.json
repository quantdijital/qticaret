{
  "name": "qticaret",
  "private": true,
  "description": "Quant Ticaret — multi-tenant e-commerce infrastructure by Quant Dijital",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@qticaret/control-plane --filter=!@qticaret/control-plane-panel",
    "dev:cp": "turbo run dev --filter=@qticaret/control-plane --filter=@qticaret/control-plane-panel",
    "dev:cp-api": "pnpm --filter control-plane dev",
    "dev:cp-panel": "pnpm --filter control-plane-panel dev",
    "dev:paytr": "pnpm --filter backend dev:paytr",
    "dev:parasut": "pnpm --filter backend dev:parasut",
    "dev:shopify": "pnpm --filter backend dev:shopify",
    "dev:aras": "pnpm --filter backend dev:aras",
    "dev:netgsm": "pnpm --filter backend dev:netgsm",
    "dev:yurtici": "pnpm --filter backend dev:yurtici",
    "dev:dhlecommerce": "pnpm --filter backend dev:dhlecommerce",
    "dev:surat": "pnpm --filter backend dev:surat",
    "dev:ptt": "pnpm --filter backend dev:ptt",
    "dev:google": "pnpm --filter backend dev:google",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "bash scripts/init-dev-env.sh",
    "db:up": "docker compose --env-file infra/docker/.env -f infra/docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose --env-file infra/docker/.env -f infra/docker/compose.dev.yml down",
    "prepare": "husky",
    "audit:deps": "bash scripts/dependency-report.sh",
    "verify:changed": "node scripts/verify-changed.mjs",
    "lock:presets": "pnpm --filter storefront lock:presets",
    "preset:previews": "pnpm --filter storefront preset:previews",
    "style:capture": "pnpm --filter storefront style:capture",
    "style:diff": "pnpm --filter storefront style:diff"
  },
  "prettier": "@qticaret/config/prettier",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@qticaret/config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
