{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "*_CORS",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "PII_*",
    "CP_*",
    "AUTH_MFA_*",
    "ADMIN_MFA",
    "PLATFORM_DOMAIN",
    "CREDENTIALS_*",
    "PAYTR_*",
    "IYZICO_*",
    "ARAS_*",
    "YURTICI_*",
    "DHL_ECOMMERCE_*",
    "SURAT_*",
    "PTT_*",
    "PARASUT_*",
    "SHOPIFY_*",
    "DB_*",
    "MEDUSA_*",
    "S3_*",
    "EMAIL_*",
    "MAILPIT_*",
    "RESEND_*",
    "NETGSM_*",
    "TEST_*",
    "LOAD_TEST",
    "PASSWORD_BREACH_CHECK",
    "SECURITY_*",
    "STOREFRONT_*",
    "OTEL_*",
    "ERROR_TRACKING_*",
    "RELEASE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".medusa/**", "*.tsbuildinfo"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration:http": {
      "cache": false
    },
    "test:integration:modules": {
      "cache": false
    }
  }
}
