{
  "name": "@qticaret/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types and Store API contracts (docs/02)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./section-variants": "./src/store/section-variants.ts",
    "./control-plane": {
      "qt-compiled": "./dist/control-plane/index.js",
      "default": "./src/control-plane/index.ts"
    },
    "./control-plane/testing": "./src/control-plane/testing.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/control-plane/package.json dist/control-plane/package.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@qticaret/config": "workspace:*",
    "@qticaret/server-kit": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
