{
  "name": "@qticaret/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types and Store API contracts (docs/02)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/store/catalog.ts",
    "./storefront": "./src/store/storefront.ts",
    "./popups": "./src/store/popups.ts",
    "./style-kit": "./src/store/style-kit.ts",
    "./listing-text": "./src/store/listing-text.ts",
    "./search-form": "./src/store/search-form.ts",
    "./section-variants": "./src/store/section-variants.ts",
    "./section-requires": "./src/store/section-requires.ts",
    "./section-look": "./src/store/section-look.ts",
    "./section-device": "./src/store/section-device.ts",
    "./section-announcement": "./src/store/section-announcement.ts",
    "./section-faq": "./src/store/section-faq.ts",
    "./section-featured": "./src/store/section-featured.ts",
    "./section-marquee": "./src/store/section-marquee.ts",
    "./section-newsletter": "./src/store/section-newsletter.ts",
    "./section-rich-text": "./src/store/section-rich-text.ts",
    "./section-banner": "./src/store/section-banner.ts",
    "./section-posts": "./src/store/section-posts.ts",
    "./section-catalog": "./src/store/section-catalog.ts",
    "./section-categories": "./src/store/section-categories.ts",
    "./section-footer": "./src/store/section-footer.ts",
    "./section-footer-rows": "./src/store/section-footer-rows.ts",
    "./section-scroller": "./src/store/section-scroller.ts",
    "./section-shelf": "./src/store/section-shelf.ts",
    "./section-strips": "./src/store/section-strips.ts",
    "./section-stats": "./src/store/section-stats.ts",
    "./section-icons": "./src/store/section-icons.ts",
    "./section-trust": "./src/store/section-trust.ts",
    "./section-steps": "./src/store/section-steps.ts",
    "./section-search-box": "./src/store/section-search-box.ts",
    "./section-hero-full": "./src/store/section-hero-full.ts",
    "./section-collage": "./src/store/section-collage.ts",
    "./section-departures": "./src/store/section-departures.ts",
    "./section-pages": "./src/store/section-pages.ts",
    "./editor-bridge": "./src/editor-bridge.ts",
    "./panel-map": {
      "qt-compiled": "./dist/panel-map/index.js",
      "default": "./src/panel-map/index.ts"
    },
    "./control-plane": {
      "qt-compiled": "./dist/control-plane/index.js",
      "default": "./src/control-plane/index.ts"
    },
    "./control-plane/testing": "./src/control-plane/testing.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/control-plane/package.json dist/control-plane/package.json && cp src/panel-map/package.json dist/panel-map/package.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@qticaret/config": "workspace:*",
    "@qticaret/server-kit": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
