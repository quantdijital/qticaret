{
  "extends": "@qticaret/config/tsconfig/base.json",
  "compilerOptions": {
    // CommonJS like the backend that runs these in Jest (no "type": "module")
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "noEmit": true
  },
  // `pnpm dev:paytr` runs src/dev with the backend's ts-node (adr/0028)
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": { "module": "commonjs", "moduleResolution": "node" }
  },
  "include": ["src"]
}
