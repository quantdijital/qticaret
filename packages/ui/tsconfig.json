{
  // React components shipped as TypeScript source; the storefront compiles them
  "extends": "@qticaret/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    // shadcn/ui files import the package by its own name (components.json aliases)
    "baseUrl": ".",
    "paths": {
      "@qticaret/ui/components/*": ["./src/components/*"],
      "@qticaret/ui/lib/*": ["./src/lib/*"],
      "@qticaret/ui/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src", "eslint.config.js"]
}
