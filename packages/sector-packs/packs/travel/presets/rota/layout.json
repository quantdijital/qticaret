    {
      "page_id": { "$handle": "page:sik-sorulan-sorular" },
      "name": "Sık Sorulan Sorular",
      "sections": [
        {
          "id": "sssorular",
          "type": "faq",
          "visible": true,
          "starts_at": null,
          "ends_at": null,
          "variant": "page",
          "title": null,
          "items": [
            { "heading": "Rezervasyon ve ödeme" },
            {
              "question": "Rezervasyonumu nasıl yaparım?",
              "body": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Tarihi ve kişi sayısını seçip sepete ekleyin, ödeme adımında katılımcı ve ödeme bilgilerinizi girin. Rezervasyonunuz tamamlandığında onay e-postası gönderilir."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "question": "Hangi ödeme yöntemlerini kullanabilirim?",
              "body": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Geçerli ödeme yöntemlerini ve kartınıza göre taksit seçeneklerini Ödeme Seçenekleri sayfamızda bulabilirsiniz."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "question": "Kartla ödeme güvenli mi?",
              "body": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Kart bilgileriniz ödeme kuruluşunun 3D Secure korumalı güvenli sayfasında işlenir; {mağaza_adı} kart bilgilerinizi görmez ve saklamaz."
                      }
                    ]
                  }
                ]
              }
            },
            { "heading": "İptal ve değişiklik" },
            {
              "question": "Rezervasyonumu iptal edebilir miyim?",
              "body": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Evet. İptal koşulları ve iade oranları İptal ve Değişiklik Koşulları sayfamızda yer alır; iptal talebinizi bize yazılı olarak iletebilirsiniz."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "question": "Yerimi başka birine devredebilir miyim?",
              "body": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Katılım koşullarını taşıyan başka bir kişiye devir, İptal ve Değişiklik Koşulları sayfamızdaki sürelere göre yapılabilir."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "question": "İadem ne zaman ödenir?",
              "body": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "İade tutarı ödeme yaptığınız yönteme iade edilir. Tutarın hesabınıza geçme süresi bankanıza göre değişir."
                      }
                    ]
                  }
                ]
              }
            },
            { "heading": "Bize ulaşın" },
            {
              "question": "Size nasıl ulaşabilirim?",
              "body": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "İletişim sayfamızdaki formdan bize yazabilirsiniz; mesajlarınızı iş günlerinde en kısa sürede yanıtlıyoruz."
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "open_first": "on",
          "single_open": "off"
        }
      ]
