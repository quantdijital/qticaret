    {
      "page_id": { "$handle": "page:hakkimizda" },
      "name": "Hakkımızda",
      "sections": [
        {
          "id": "hakkimizdametin",
          "type": "rich_text",
          "visible": true,
          "starts_at": null,
          "ends_at": null,
          "variant": "article",
          "title": null,
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Köklerimizden geleceğe.",
                    "marks": [{ "type": "bold" }]
                  },
                  {
                    "type": "text",
                    "text": " {mağaza_adı}, el işçiliğini günlük kullanımla buluşturan bir bıçak mağazasıdır. Çakıdan av bıçağına, şef bıçağından koleksiyon parçalarına kadar her ürünü kullanılmak için seçer; kutusundan sunumuna kadar özenle hazırlarız."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dövme çelik geleneğinden ve desenli çeliğin ustalığından aldığımız ilhamı, bugünün paslanmaz çelikleri ve elinize oturan saplarla birleştiriyoruz."
                  }
                ]
              }
            ]
          },
          "outline": "auto",
          "questions": "auto"
        },
        {
          "id": "hakkimizdahikaye",
          "type": "rich_text",
          "visible": true,
          "starts_at": null,
          "ends_at": null,
          "variant": "with_image",
          "title": "Ateşten doğan karakter",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bir bıçağın karakteri çeliğinde, ısıl işleminde ve elinize oturan sapında saklıdır. {mağaza_adı} olarak sunduğumuz her ürünü bu üç ölçüyle seçiyor, ağzını ve dengesini kendimiz deniyoruz. Mutfakta her gün kullanacağınız bir şef bıçağı da doğada yanınızdan ayırmadığınız bir çakı da aynı özeni hak eder."
                  }
                ]
              }
            ]
          },
          "image": {
            "$image": "images/acilis-bileme.webp",
            "alt": "Su taşında bilenen mutfak bıçağı"
          },
          "image_side": "end"
        },
        {
          "id": "hakkimizdainanc",
          "type": "rich_text",
          "visible": true,
