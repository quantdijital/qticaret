              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Dövme çelik geleneğinden aldığımız güçle, Türkiye'den çıkan ve dünyada tanınan bir bıçak ve outdoor markası olmak."
                  }
                ]
              }
            ]
          }
        },
