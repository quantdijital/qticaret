{
  "name": "@qticaret/server-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Server code shared by the shop backend and the control plane: crypto, envelope encryption, signatures, redaction, env helpers, request paths, rate limits (adr/0061)",
  "exports": {
    ".": {
      "qt-compiled": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./escrow": {
      "qt-compiled": "./dist/crypto/escrow.js",
      "default": "./src/crypto/escrow.ts"
    },
    "./testing/age": "./src/testing/age.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --silent"
  },
  "dependencies": {
    "age-encryption": "0.3.1",
    "ioredis": "5.11.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@qticaret/config": "workspace:*",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "typescript": "5.9.3"
  }
}
