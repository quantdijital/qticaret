# Template for apps/storefront/.env.local, created by scripts/init-dev-env.sh:
# __NAME__ gets the value of NAME from infra/docker/.env. Never commit the
# real file (docs/04). Next.js reads .env.local in development.

# The backend, from the storefront's server (never from the browser; adr/0046 §5)
MEDUSA_BACKEND_URL=http://localhost:9000
# The storefront's own public origin: sent as Origin to the backend (CSRF) and
# used for payment return addresses; must be in the backend's STORE_CORS
STOREFRONT_ORIGIN=http://localhost:8000
# The sales channel's publishable key. Left empty in development, the
# storefront asks the backend's /dev/storefront-key for the demo store's
STOREFRONT_PUBLISHABLE_KEY=
# Signs the shopper's address on every Store API request; the backend's env
# holds the same value
STOREFRONT_IP_SECRET=__STOREFRONT_IP_SECRET__
# Origins a card provider's hosted form is framed from (CSP frame-src), space
# separated. Empty: PayTR's (https://www.paytr.com), plus the fake PayTR of
# `pnpm dev:paytr` (http://127.0.0.1:9102) in development
PAYMENT_FRAME_ORIGINS=
# A card provider's own payment page shoppers are sent to (iyzico), space
# separated. Empty: https://cpp.iyzipay.com and https://sandbox-cpp.iyzipay.com
PAYMENT_REDIRECT_ORIGINS=
