{
  // Playwright's tests run in Node: Node types here, never in the app's own tsconfig
  "extends": "@qticaret/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    // resolved-style/ runs under Node's own type stripping, which wants `.ts` in imports
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts"]
}
