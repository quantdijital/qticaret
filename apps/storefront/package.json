{
  "name": "@qticaret/storefront",
  "version": "0.0.0",
  "private": true,
  "description": "Quant Ticaret storefront: server-rendered, theme-agnostic shell over the Store API (F18, adr/0046)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 8000",
    "build": "next build",
    "start": "next start --port 8000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lock:presets": "PRESET_LOCK=update vitest run src/lib/__tests__/preset-lock.spec.tsx src/lib/__tests__/preset-lock-pages.spec.tsx -u",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "style:capture": "node e2e/resolved-style/capture.ts",
    "style:diff": "node e2e/resolved-style/diff-cli.ts",
    "preset:previews": "node e2e/preset-preview/capture.ts"
  },
  "dependencies": {
    "@qticaret/theme-atolye": "workspace:*",
    "@qticaret/types": "workspace:*",
    "@qticaret/ui": "workspace:*",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.64.0",
    "@qticaret/config": "workspace:*",
    "@qticaret/sector-packs": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
