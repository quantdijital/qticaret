# Template for apps/control-plane/.env and .env.test (adr/0061), created by
# `pnpm env:init`: __GENERATED__ gets a fresh random value, __NAME__ the value
# of NAME from infra/docker/.env. Never commit the real files (docs/04).
#
# First run: `pnpm db:up`, then `pnpm --filter control-plane db:setup`
# (creates the qticaret_cp database and migrates it), then
# `pnpm dev:cp` (the API on http://localhost:9100 and its panel on
# http://localhost:5174; `dev:cp-api` the API alone). The first owner:
# `pnpm --filter control-plane cp:create-owner email=<address>`, then the
# e-mailed link (Mailpit). Integration tests make throwaway
# databases of their own on the same server (DB_* below).

DATABASE_URL=postgres://postgres:__POSTGRES_PASSWORD__@localhost:55432/qticaret_cp
DB_NAME=qticaret_cp
DB_HOST=localhost
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=__POSTGRES_PASSWORD__

# Sessions and rate limit counters; required outside development and test.
# Its keys live under the control plane's own namespace (its database).
REDIS_URL=redis://localhost:56379

# The control plane's panel (apps/control-plane-panel, port 5174); same
# origin once deployed.
ADMIN_CORS=http://localhost:5174
AUTH_CORS=http://localhost:5174

# Required, no fallback: the server refuses to start without them.
JWT_SECRET=__GENERATED__
COOKIE_SECRET=__GENERATED__

# Keyed hash of identities counted without being kept (a sign-in's e-mail
# in the rate limiter): 32 random bytes as hex.
CP_HASH_KEY=__GENERATED__

MEDUSA_DISABLE_TELEMETRY=true

# Staff 2FA (adr/0061 §3.5): Medusa's MFA seals each TOTP secret with this
# key, 32 random bytes as hex. 2FA is mandatory; ADMIN_MFA=off skips it on
# this machine only (refused outside development and test).
AUTH_MFA_ENCRYPTION_KEY=__GENERATED__
# ADMIN_MFA=off

# Envelope encryption's local key-encryption key (adr/0061 §4.1): 32 random
# bytes as hex; a comma-separated list, newest first, while a rotation runs.
# Seals a sole proprietor's TCKN (C7) and the platform's secrets (its signing
# key, C8). Rotation: put a new key first, run `pnpm --filter control-plane
# cp:keys rewrap` (or Anahtarlar > Yeniden sar), and remove the old key only
# once `cp:keys status` lists it as removable.
CP_MASTER_KEY=__GENERATED__

# Escrow (adr/0061 §4.3): a shop's runtime secrets are sealed to these
# offline age recipients, the backups' own (infra/backup/recipients.txt):
# public keys only (age1..., comma-separated). The identity that opens them
# never comes to this machine; an AGE-SECRET-KEY-... here is refused. On a
# developer's machine: a fresh recipient whose identity was thrown away, so
# what it seals opens nowhere (development data needs no recovery).
CP_ESCROW_RECIPIENTS=__AGE_RECIPIENT__

# The platform's own domain: a shop's subdomain is <slug>.<PLATFORM_DOMAIN>.
# Not decided yet; on this machine the browser resolves *.localhost itself.
PLATFORM_DOMAIN=localhost

# The control plane's panel: invitation links point here (https once deployed).
CP_PANEL_URL=http://localhost:5174

# E-mail (adr/0061 Ek C4): Mailpit on this machine (http://localhost:58025).
# Unset, nothing is sent: an invitation's link is shown to whoever made it.
# The tests leave these out.
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://127.0.0.1:58025
EMAIL_FROM=destek@quantticaret.test

# Where a shop's plan document may be pushed (adr/0061 Ek C9): `name[:port]`
# entries, comma-separated: single-label names (Docker services) or names and
# `.suffixes` under .internal / .local. Without a port only 9000, 80 and 443.
# Unset: this machine only here (9000, 9200-9299), and no push once deployed
# (the shops pull every 15 minutes). A shop's address is set by the
# provisioner (C10); here with `cp:fleet set-api-url <slug> <url>`.
# CP_TENANT_API_HOSTS=

# Who sets a new shop up (adr/0061 §6, Ek C10). `local`, on this machine
# only: a database qt_tenant_<slug> with its own role in the dev Postgres,
# the shop's env in infra/tenants/local/<slug>/.env (0600, git-ignored) and
# the compiled backend (`pnpm turbo run build --filter=@qticaret/backend`)
# started on a port in 9200-9299. CP_LOCAL_PG_ADMIN_URL is the dev
# Postgres's own administrative login, used for that alone. Unset: no
# provisioning. Refused anywhere but development; the tests use a fake.
CP_PROVISIONER=local
CP_LOCAL_PG_ADMIN_URL=postgres://postgres:__POSTGRES_PASSWORD__@localhost:55432/postgres

# How a local shop's backup ("Şimdi yedekle", infra/backup/backup.sh) reaches
# pg_dump and psql: unset, this machine's own tools when installed, else the
# dev container (the line below). The backup also needs `age` installed
# (`sudo apt install age`); it encrypts to CP_ESCROW_RECIPIENTS and lands in
# infra/tenants/backups/<slug>/ (git-ignored). Development only.
# CP_LOCAL_PG_EXEC=docker exec -i -e PGUSER=postgres qticaret-dev-postgres-1

# Where a local shop reaches this control plane (its plan pull and hourly
# usage report, Ek C13). Unset: http://localhost:9100. Set it only for a
# second copy on other ports; this machine only, development only.
# CP_LOCAL_CONTROL_PLANE_URL=http://localhost:9110

# Our own e-invoice for subscriptions (adr/0061 §7, Ek C16): off until the
# company is founded; a paid charge's invoice fields stay empty.
# CP_INVOICING=off
