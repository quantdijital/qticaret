{
  "name": "@qticaret/control-plane",
  "version": "0.0.0",
  "private": true,
  "description": "Quant Ticaret control plane: tenants, plans, provisioning (Medusa v2, adr/0061)",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "medusa develop -p 9100",
    "build": "medusa build",
    "start": "medusa start -p 9100",
    "medusa": "medusa",
    "db:setup": "medusa db:create --db qticaret_cp --no-interactive && pnpm db:migrate",
    "db:migrate": "medusa db:migrate --skip-scripts --execute-safe-links",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --maxWorkers=1 --forceExit",
    "cp:create-owner": "medusa exec ./src/scripts/create-owner.ts",
    "cp:end-sessions": "medusa exec ./src/scripts/end-sessions.ts",
    "cp:seed-dev": "medusa exec ./src/scripts/seed-dev.ts",
    "cp:keys": "medusa exec ./src/scripts/keys.ts",
    "cp:fleet": "medusa exec ./src/scripts/fleet.ts",
    "cp:tenant-create": "medusa exec ./src/scripts/tenant-create.ts",
    "cp:tenant": "medusa exec ./src/scripts/tenant.ts"
  },
  "dependencies": {
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@qticaret/sector-packs": "workspace:*",
    "@qticaret/server-kit": "workspace:*",
    "@qticaret/types": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@qticaret/config": "workspace:*",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
