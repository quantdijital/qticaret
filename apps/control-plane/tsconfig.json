{
  "extends": "@qticaret/config/tsconfig/base.json",
  "compilerOptions": {
    // As apps/backend: Medusa compiles to CommonJS with decorators (adr/0001)
    "target": "ES2021",
    "lib": ["ES2023"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "sourceMap": false,
    "inlineSourceMap": true,
    "outDir": "./.medusa/server",
    "rootDir": "./"
  },
  "ts-node": {
    "swc": true
  },
  "include": ["**/*", ".medusa/types/*"],
  "exclude": ["node_modules", ".medusa/server", ".medusa/admin", ".cache", "eslint.config.*"]
}
