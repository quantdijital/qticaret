{
  // Admin extensions are bundled by Medusa's Vite build as ESM, unlike the
  // CommonJS server code, so they type-check with bundler settings.
  "extends": "@qticaret/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    // One React type package: the workspace also holds the panel's React 19
    // types, and pnpm's hoisted copy would otherwise reach Medusa's packages
    "baseUrl": "../..",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["./**/*"]
}
