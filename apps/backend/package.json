{
  "name": "@qticaret/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Quant Ticaret backend and admin (Medusa v2, adr/0001)",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "medusa develop",
    "dev:paytr": "ts-node ../../packages/testing/src/dev/paytr.ts",
    "build": "medusa build",
    "start": "medusa start",
    "medusa": "medusa",
    "tenant:bootstrap": "medusa exec ./src/scripts/bootstrap-tenant.ts",
    "seed:demo": "NODE_ENV=${NODE_ENV:-development} medusa exec ./src/scripts/seed-demo.ts",
    "seed:demo-orders": "NODE_ENV=${NODE_ENV:-development} medusa exec ./src/scripts/seed-demo-orders.ts",
    "tr-address:import": "medusa exec ./src/scripts/import-tr-address.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin",
    "test": "pnpm test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --maxWorkers=1 --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --maxWorkers=1 --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/loyalty-plugin": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "fast-xml-parser": "5.11.2",
    "ioredis": "5.11.1",
    "pino": "10.4.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@qticaret/config": "workspace:*",
    "@qticaret/testing": "workspace:*",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
