{
  "name": "@qticaret/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Quant Ticaret backend and admin (Medusa v2, adr/0001)",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "medusa develop",
    "dev:paytr": "ts-node ../../packages/testing/src/dev/paytr.ts",
    "dev:parasut": "ts-node ../../packages/testing/src/dev/parasut.ts",
    "dev:shopify": "ts-node ../../packages/testing/src/dev/shopify.ts",
    "dev:aras": "ts-node ../../packages/testing/src/dev/aras.ts",
    "dev:geliver": "ts-node ../../packages/testing/src/dev/geliver.ts",
    "dev:netgsm": "ts-node ../../packages/testing/src/dev/netgsm.ts",
    "dev:yurtici": "ts-node ../../packages/testing/src/dev/yurtici.ts",
    "dev:google": "ts-node ../../packages/testing/src/dev/google.ts",
    "build": "medusa build && node ../../scripts/stamp-release.mjs",
    "start": "medusa start",
    "medusa": "medusa",
    "tenant:bootstrap": "medusa exec ./src/scripts/bootstrap-tenant.ts",
    "tenant:invite-owner": "medusa exec ./src/scripts/invite-owner.ts",
    "tenant:plan-import": "medusa exec ./src/scripts/plan-import.ts",
    "tenant:apply-pack": "medusa exec ./src/scripts/apply-pack.ts",
    "tenant:apply-preset": "medusa exec ./src/scripts/apply-preset.ts",
    "seed:demo": "NODE_ENV=${NODE_ENV:-development} medusa exec ./src/scripts/seed-demo.ts",
    "seed:demo-orders": "NODE_ENV=${NODE_ENV:-development} medusa exec ./src/scripts/seed-demo-orders.ts",
    "demo:remove": "NODE_ENV=${NODE_ENV:-development} medusa exec ./src/scripts/remove-demo.ts",
    "customer:test": "NODE_ENV=${NODE_ENV:-development} medusa exec ./src/scripts/create-test-customer.ts",
    "shop:profile": "NODE_ENV=${NODE_ENV:-development} medusa exec ./src/scripts/load-shop-profile.ts",
    "tr-address:import": "medusa exec ./src/scripts/import-tr-address.ts",
    "messaging:samples": "medusa exec ./src/scripts/messaging-samples.ts",
    "search:rebuild": "medusa exec ./src/scripts/search-rebuild.ts",
    "search:status": "medusa exec ./src/scripts/search-status.ts",
    "links:rewrite": "medusa exec ./src/scripts/content-links.ts",
    "summary:backfill": "medusa exec ./src/scripts/summary-backfill.ts",
    "legacy:backfill": "medusa exec ./src/scripts/legacy-backfill.ts",
    "authors:backfill": "medusa exec ./src/scripts/authors-backfill.ts",
    "category-covers:backfill": "medusa exec ./src/scripts/category-covers-backfill.ts",
    "brand-logo-sizes:backfill": "medusa exec ./src/scripts/brand-logo-sizes-backfill.ts",
    "media:derivatives": "medusa exec ./src/scripts/media-derivatives.ts",
    "credentials:keys": "medusa exec ./src/scripts/credentials-keys.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --maxWorkers=1 --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --maxWorkers=1 --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@medusajs/admin-shared": "2.22.6",
    "@medusajs/caching": "2.22.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/dashboard": "2.22.6",
    "@medusajs/draft-order": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/js-sdk": "2.22.6",
    "@medusajs/loyalty-plugin": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@qticaret/sector-packs": "workspace:*",
    "@qticaret/server-kit": "workspace:*",
    "@qticaret/types": "workspace:*",
    "busboy": "1.6.0",
    "dompurify": "3.4.17",
    "fast-xml-parser": "5.12.0",
    "ioredis": "5.11.1",
    "jsdom": "26.1.0",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.6",
    "@qticaret/config": "workspace:*",
    "@qticaret/testing": "workspace:*",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/busboy": "1.5.4",
    "@types/jest": "29.5.14",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "smtp-server": "3.21.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
