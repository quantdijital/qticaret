# Template for apps/backend/.env and .env.test, created by
# scripts/init-dev-env.sh: __GENERATED__ gets a fresh random value, __NAME__
# the value of NAME from infra/docker/.env. Never commit the real files (docs/04).

DATABASE_URL=postgres://postgres:__POSTGRES_PASSWORD__@localhost:55432/qticaret
DB_NAME=qticaret
# Used by integration tests (@medusajs/test-utils creates a throwaway DB).
DB_HOST=localhost
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=__POSTGRES_PASSWORD__

REDIS_URL=redis://localhost:56379

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
# The backend's public address (iyzico sends the shopper back to it); https and
# required on staging and production. Unset here means http://localhost:9000.
# BACKEND_URL=https://api.example.com
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Required, no fallback: the server refuses to start without them.
JWT_SECRET=__GENERATED__
COOKIE_SECRET=__GENERATED__

# F18 (adr/0046 §5): the storefront's server signs each shopper's address with
# it; the storefront's env holds the same value. Unset, only the connection's
# own address counts for limits and evidence.
STOREFRONT_IP_SECRET=__STOREFRONT_IP_SECRET__

# Where a publication or a settings save tells the storefront's server to
# show it at once (adr/0048 ek 2026-11-03: `POST /api/yenile`, signed with the
# secret above). Unset: http://localhost:8000 here, the shop's canonical host
# once deployed (https only there).
# STOREFRONT_ORIGIN=http://localhost:8000

# Customer tax id encryption (AES-256-GCM) and lookup hash (HMAC-SHA256),
# 32 random bytes each as hex (adr/0009). Losing the encryption key makes
# stored tax ids unreadable; keep it in the secret store in production.
PII_ENCRYPTION_KEY=__GENERATED__
PII_HASH_KEY=__GENERATED__

# The shop's provider accounts (PayTR, iyzico, Geliver) entered in the panel are
# stored in envelopes whose data keys are wrapped under this key (adr/0027,
# adr/0061 Ek C17). Losing it means entering them again; keep it in the secret
# store in production. To rotate it without downtime, replace it with the list
# form, newest key first, then follow docs/08 (credentials:keys status/rewrap):
#   CREDENTIALS_ENCRYPTION_KEYS=<new 64-hex key>,<this key>
CREDENTIALS_ENCRYPTION_KEY=__GENERATED__

# Staff 2FA (adr/0040): Medusa's MFA seals each TOTP secret with this key,
# 32 random bytes as hex. Required on staging and production; losing it
# means every staff member sets 2FA up again.
AUTH_MFA_ENCRYPTION_KEY=__GENERATED__
# Local only: `off` signs in without 2FA (ignored on staging and production).
# ADMIN_MFA=off
# Have I Been Pwned's breach list for new passwords (k-anonymity: only a
# hash prefix leaves; adr/0043). On unless NODE_ENV is development or test;
# off here so a developer's sign-ups never reach the outside service. A
# deployed shop's environment leaves it out (on).
PASSWORD_BREACH_CHECK=off
# Observability (F15.4, adr/0045), all off when unset: GlitchTip's DSN
# (self-hosted in Türkiye) for the error lines, the OTLP collector for
# traces (instrumentation.ts), the deployed version on each error event.
# ERROR_TRACKING_DSN=https://<public key>@hata.example.com/<project id>
# OTEL_EXPORTER_OTLP_ENDPOINT=https://iz.example.com
# OTEL_SERVICE_NAME=qticaret-backend
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# RELEASE=
# Load tests from one machine (infra/k6, F15.3): per-IP limits a thousand
# times larger. Development, test and staging only; refused live.
# LOAD_TEST=on
# Where to report a security issue (security.txt, RFC 9116): mailto: or
# https:, comma separated, and the disclosure policy's page. Platform-wide.
# SECURITY_CONTACT=mailto:guvenlik@example.com
# SECURITY_POLICY_URL=https://example.com/guvenlik

# The fake PayTR on this machine (adr/0028): start it with `pnpm dev:paytr`.
# Real PayTR cannot notify localhost. Refused on staging and production.
PAYTR_BASE_URL=http://127.0.0.1:9102

# The fake Geliver on this machine (adr/0031): start it with `pnpm dev:geliver`.
# Refused on staging and production.
GELIVER_BASE_URL=http://127.0.0.1:9103/api/v1

# The fake Aras and Yurtiçi on this machine (adr/0035): `pnpm dev:aras`, `pnpm dev:yurtici`.
# Refused on staging and production.
ARAS_BASE_URL=http://127.0.0.1:9104
YURTICI_BASE_URL=http://127.0.0.1:9105
# Shipment tracking poll, in minutes (1-30, default 30): 1 shows a parcel moved
# on a fake's tracking page within a minute. Ignored on staging and production.
SHIPMENT_POLL_MINUTES=

MEDUSA_DISABLE_TELEMETRY=true

# Local S3 (SeaweedFS, adr/0006). The file provider is wired in F3.
S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_BUCKET=qticaret
S3_FILE_URL=http://localhost:58333/qticaret
S3_ACCESS_KEY_ID=__S3_ACCESS_KEY_ID__
S3_SECRET_ACCESS_KEY=__S3_SECRET_ACCESS_KEY__

# Product videos (adr/0069 §4): the distribution's ffmpeg and ffprobe (on a Mac
# `brew install ffmpeg`, on Ubuntu `apt install ffmpeg`), absolute paths. Unset,
# they are found on PATH; missing, video uploads are closed (one error at start).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# E-mail (F9, adr/0036): Mailpit on this machine, its UI and send API at
# http://localhost:58025. Deployed shops use resend with RESEND_API_KEY.
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://127.0.0.1:58025
EMAIL_FROM=bildirim@magaza.test
# Resend's signing secret for /hooks/resend (deployed shops; tests make their own)
# RESEND_WEBHOOK_SECRET=
# F10 M9: a shopper's e-mail domain must take mail (its MX); "off" turns it off.
# On unless NODE_ENV=test.
# EMAIL_DOMAIN_CHECK=on

# The fake Netgsm on this machine (adr/0036): `pnpm dev:netgsm`. The shop's
# own SMS account is entered in the panel. Refused on staging and production.
NETGSM_BASE_URL=http://127.0.0.1:9106

# Google for the shop's Merchant Center, Search Console and Google reviews
# (F10 M13, adr/0038 §5, adr/0058): the platform's OAuth client (Google Cloud >
# APIs & Services > Credentials, a web client with BACKEND_URL/google/callback
# as a redirect URI). Off until both are set. Google reviews also need the
# project's Business Profile API access (docs/entegrasyonlar/google-business-profile.md).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# The fake Google on this machine (`pnpm dev:google`) with its fixed client;
# refused on staging and production:
# GOOGLE_BASE_URL=http://127.0.0.1:9109
# GOOGLE_OAUTH_CLIENT_ID=gelistirme-google-istemcisi.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=gelistirme-google-sirri

# F8 (adr/0034 §5): the platform's Paraşüt API client, asked of
# destek@parasut.com once; each shop connects its company in the panel
# (Settings > E-invoice). Off until both are set. PARASUT_BASE_URL only for
# the fake Paraşüt on a developer's machine (`pnpm dev:parasut`).
# PARASUT_CLIENT_ID=
# PARASUT_CLIENT_SECRET=
# PARASUT_BASE_URL=http://127.0.0.1:9108

# F14 (adr/0042): a fake Shopify for a migration on a developer's machine
# (`pnpm dev:shopify`); a shop's own Shopify app is entered in the panel.
# SHOPIFY_BASE_URL=http://127.0.0.1:9107

# Chrome's field data for the shop's Core Web Vitals (F10.11): the platform's
# Google Cloud API key with the Chrome UX Report API enabled. Off until set.
# CRUX_API_KEY=

# AI core (adr/0071 §8): the daily abuse ceiling per shop, by kind of work. It
# holds on the shop's own key too. Unset: text 500, image 100, video 10 a day; a
# value may only lower the default (0 closes that kind of work).
# AI_DAILY_LIMIT_TEXT=500
# AI_DAILY_LIMIT_IMAGE=100
# AI_DAILY_LIMIT_VIDEO=10
# The storefront's "search in your own words" (adr/0077 §7): calls per shop and day,
# counted apart from the staff's work, on the shop's own key. Unset: 500; 0 closes it.
# AI_STORE_SEARCH_DAILY_LIMIT=500

# Social login (F10.2, adr/0037 §3): the shop's own OAuth clients, made at
# provisioning; each provider is off until all of its values are set.
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
# GOOGLE_AUTH_CALLBACK_URL=https://<storefront>/hesap/giris/google
# APPLE_AUTH_CLIENT_ID=
# APPLE_AUTH_TEAM_ID=
# APPLE_AUTH_KEY_ID=
# APPLE_AUTH_PRIVATE_KEY=
# APPLE_AUTH_CALLBACK_URL=https://<storefront>/hesap/giris/apple

# Medusa's own admin screens (/app) are off; the shop works in the panel
# (adr/0022 §3). The platform team may open them for a while:
# MEDUSA_ADMIN=on

# The control plane (adr/0061 §3, Ek C9). Unset here: the shop runs unmanaged
# (active, no limits, platform flags at their defaults), as on every developer's
# machine and in the tests. Required once deployed; the provisioner (C10) writes
# them. CONTROL_PLANE_PUBLIC_KEYS: `pnpm --filter control-plane cp:keys public-keys`.
# TENANT_SIGNING_KEY is this shop's private key: never logged, never shared.
# CONTROL_PLANE_URL=http://localhost:9100
# CONTROL_PLANE_PUBLIC_KEYS=
# TENANT_ID=
# TENANT_SIGNING_KEY=

# adr/0072: a fake BirFatura file server (invoice PDFs); development and test only, refused when deployed
BIRFATURA_BASE_URL=
