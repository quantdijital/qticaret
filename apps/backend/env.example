# Template for apps/backend/.env and .env.test, created by
# scripts/init-dev-env.sh: __GENERATED__ gets a fresh random value, __NAME__
# the value of NAME from infra/docker/.env. Never commit the real files (docs/04).

DATABASE_URL=postgres://postgres:__POSTGRES_PASSWORD__@localhost:55432/qticaret
DB_NAME=qticaret
# Used by integration tests (@medusajs/test-utils creates a throwaway DB).
DB_HOST=localhost
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=__POSTGRES_PASSWORD__

REDIS_URL=redis://localhost:56379

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
# The backend's public address (iyzico sends the shopper back to it); https and
# required on staging and production. Unset here means http://localhost:9000.
# BACKEND_URL=https://api.example.com
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Required, no fallback: the server refuses to start without them.
JWT_SECRET=__GENERATED__
COOKIE_SECRET=__GENERATED__

# Customer tax id encryption (AES-256-GCM) and lookup hash (HMAC-SHA256),
# 32 random bytes each as hex (adr/0009). Losing the encryption key makes
# stored tax ids unreadable; keep it in the secret store in production.
PII_ENCRYPTION_KEY=__GENERATED__
PII_HASH_KEY=__GENERATED__

# The shop's provider accounts (PayTR, iyzico, Geliver) entered in the panel are
# stored with AES-256-GCM under this key (adr/0027). Losing or changing it
# means entering them again; keep it in the secret store in production.
CREDENTIALS_ENCRYPTION_KEY=__GENERATED__

# The fake PayTR on this machine (adr/0028): start it with `pnpm dev:paytr`.
# Real PayTR cannot notify localhost. Refused on staging and production.
PAYTR_BASE_URL=http://127.0.0.1:9102

# The fake Geliver on this machine (adr/0031): start it with `pnpm dev:geliver`.
# Refused on staging and production.
GELIVER_BASE_URL=http://127.0.0.1:9103/api/v1

# The fake Aras and Yurtiçi on this machine (adr/0035): `pnpm dev:aras`, `pnpm dev:yurtici`.
# Refused on staging and production.
ARAS_BASE_URL=http://127.0.0.1:9104
YURTICI_BASE_URL=http://127.0.0.1:9105

MEDUSA_DISABLE_TELEMETRY=true

# Local S3 (SeaweedFS, adr/0006). The file provider is wired in F3.
S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_BUCKET=qticaret
S3_FILE_URL=http://localhost:58333/qticaret
S3_ACCESS_KEY_ID=__S3_ACCESS_KEY_ID__
S3_SECRET_ACCESS_KEY=__S3_SECRET_ACCESS_KEY__

# E-mail (F9, adr/0036): Mailpit on this machine, its UI and send API at
# http://localhost:58025. Deployed shops use resend with RESEND_API_KEY.
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://127.0.0.1:58025
EMAIL_FROM=bildirim@magaza.test
# Resend's signing secret for /hooks/resend (deployed shops; tests make their own)
# RESEND_WEBHOOK_SECRET=

# The fake Netgsm on this machine (adr/0036): `pnpm dev:netgsm`. The shop's
# own SMS account is entered in the panel. Refused on staging and production.
NETGSM_BASE_URL=http://127.0.0.1:9106

# Social login (F10.2, adr/0037 §3): the shop's own OAuth clients, made at
# provisioning; each provider is off until all of its values are set.
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
# GOOGLE_AUTH_CALLBACK_URL=https://<storefront>/hesap/giris/google
# APPLE_AUTH_CLIENT_ID=
# APPLE_AUTH_TEAM_ID=
# APPLE_AUTH_KEY_ID=
# APPLE_AUTH_PRIVATE_KEY=
# APPLE_AUTH_CALLBACK_URL=https://<storefront>/hesap/giris/apple
